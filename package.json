{
  "name": "zedu-api-automation",
  "version": "1.0.0",
  "description": "Automated API test suite for the Zedu platform",
  "main": "index.js",
  "scripts": {
    "test": "jest --runInBand --forceExit",
    "test:auth": "jest tests/auth.test.js --runInBand --forceExit",
    "test:users": "jest tests/users.test.js --runInBand --forceExit",
    "test:organisations": "jest tests/organisations.test.js --runInBand --forceExit"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "verbose": true
  }
}
